# Copy this file to .streamlit/secrets.toml and fill in your own values.
   # NEVER commit the real secrets.toml to git / SharePoint.

   # Password gate for the app itself (shown before anything else loads)
   app_password = "choose_your_own_password_here"

   [dropbox]
   # --- Option A: quick testing (expires after a few hours) ---
   # access_token = "sl.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

   # --- Option B: production (never expires) - recommended since this app ---
   # --- will be embedded in SharePoint for everyone to use ---
   app_key = "your_dropbox_app_key"
   app_secret = "your_dropbox_app_secret"
   refresh_token = "your_dropbox_refresh_token"

   # Paths to the two files IN Dropbox (case-sensitive, include leading slash)
   gps_path = "/GPS Dummy Data.xlsx"
   firstbeat_path = "/firstbeat_data.xlsx"

   # Set to true if your files live in a Dropbox Business "Team space" (shared
   # team folder) rather than your personal "My files". Leave as true if
   # you're not sure - it's safe either way for most business accounts.
   team_space = true
